# =============================================================
# test_partition_independence.mojo
#
# Does a parallel sum return the same bits for every thread count?
#
#   naive_sum(T):  the array is cut into T chunks, one per worker;
#                  chunk sums are added in order. The grouping of
#                  the additions depends on T.
#   fixed_sum(T):  the array is cut into N_BLOCKS blocks, whatever
#                  T is. Each block is summed with Kahan compensation,
#                  then the block sums are combined by a fixed
#                  pairwise tree. T workers execute the blocks with
#                  `parallelize`; the grouping does not depend on T.
#
# Input: 10,000,000 doubles with mixed signs and magnitudes spanning
# twelve decades, generated by a 64-bit LCG.
# =============================================================

from collections import List
from algorithm import parallelize

alias N_BLOCKS = 4096


def naive_sum(x: List[Float64], workers: Int) -> Float64:
    var n = len(x)
    var xp = x.unsafe_ptr()
    var partial = List[Float64]()
    for _ in range(workers):
        partial.append(0.0)
    var pp = partial.unsafe_ptr()
    var chunk = (n + workers - 1) // workers
    @parameter
    def one(w: Int):
        var lo = w * chunk
        var hi = lo + chunk
        if hi > n:
            hi = n
        var s: Float64 = 0.0
        var i = lo
        while i < hi:
            s += xp[i]
            i += 1
        pp[w] = s
    parallelize[one](workers, workers)
    var total: Float64 = 0.0
    for w in range(workers):
        total += partial[w]
    return total


def fixed_sum(x: List[Float64], workers: Int) -> Float64:
    var n = len(x)
    var xp = x.unsafe_ptr()
    var block = List[Float64]()
    for _ in range(N_BLOCKS):
        block.append(0.0)
    var bp = block.unsafe_ptr()
    var size = (n + N_BLOCKS - 1) // N_BLOCKS
    @parameter
    def one(b: Int):
        var lo = b * size
        var hi = lo + size
        if hi > n:
            hi = n
        var s: Float64 = 0.0
        var c: Float64 = 0.0
        var i = lo
        while i < hi:
            var y = xp[i] - c
            var t = s + y
            c = (t - s) - y
            s = t
            i += 1
        bp[b] = s
    parallelize[one](N_BLOCKS, workers)
    # fixed pairwise tree over the block sums (N_BLOCKS is a power of two)
    var m = N_BLOCKS
    while m > 1:
        var half = m // 2
        for k in range(half):
            block[k] = block[2 * k] + block[2 * k + 1]
        m = half
    return block[0]


def main():
    var n = 10_000_000
    var x = List[Float64]()
    var state: UInt64 = 2026
    for _ in range(n):
        state = state * 6364136223846793005 + 1442695040888963407
        var u = Float64(state >> 11) * (1.0 / 9007199254740992.0)
        state = state * 6364136223846793005 + 1442695040888963407
        var e = Int((state >> 33) % 13)            # decade 0..12
        var mag: Float64 = 1.0
        for _ in range(e):
            mag *= 10.0
        x.append((u - 0.5) * mag * 1.0e-6)

    print("KEY n_elements", n, "n_blocks", N_BLOCKS)

    # ---- Level 2: thread counts 1..16
    var ref_fixed = fixed_sum(x, 1)
    var ref_naive = naive_sum(x, 1)
    var fixed_same = 0
    var naive_same = 0
    var n_counts = 0
    for t in range(1, 17):
        var f = fixed_sum(x, t)
        var g = naive_sum(x, t)
        print("KEY workers", t, "fixed", f, "naive", g)
        n_counts += 1
        if f == ref_fixed:
            fixed_same += 1
        if g == ref_naive:
            naive_same += 1
    print("KEY fixed_sum_identical_to_1_worker", fixed_same, "of", n_counts)
    print("KEY naive_sum_identical_to_1_worker", naive_same, "of", n_counts)

    # ---- Level 1: 200 repeated runs at 16 workers
    var rep_same = 0
    for _ in range(200):
        if fixed_sum(x, 16) == ref_fixed:
            rep_same += 1
    print("KEY fixed_sum_repeats_identical", rep_same, "of 200")
    var rep_naive = 0
    var g16 = naive_sum(x, 16)
    for _ in range(200):
        if naive_sum(x, 16) == g16:
            rep_naive += 1
    print("KEY naive_sum_16_workers_repeats_identical", rep_naive, "of 200")
