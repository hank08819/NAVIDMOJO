# Fixed-order sum: reversed input and cost against the naive parallel sum (best of 7).
# =============================================================
# test_partition_independence.mojo
#
# Does a parallel sum return the same bits for every thread count?
#
#   naive_sum(T):  the array is cut into T chunks, one per worker;
#                  chunk sums are added in order. The grouping of
#                  the additions depends on T.
#   fixed_sum(T):  the array is cut into N_BLOCKS blocks, whatever
#                  T is. Each block is summed with Kahan compensation,
#                  then the block sums are combined by a fixed
#                  pairwise tree. T workers execute the blocks with
#                  `parallelize`; the grouping does not depend on T.
#
# Input: 10,000,000 doubles with mixed signs and magnitudes spanning
# twelve decades, generated by a 64-bit LCG.
# =============================================================

from collections import List
from algorithm import parallelize
from time import perf_counter_ns

alias N_BLOCKS = 4096


def naive_sum(x: List[Float64], workers: Int) -> Float64:
    var n = len(x)
    var xp = x.unsafe_ptr()
    var partial = List[Float64]()
    for _ in range(workers):
        partial.append(0.0)
    var pp = partial.unsafe_ptr()
    var chunk = (n + workers - 1) // workers
    @parameter
    def one(w: Int):
        var lo = w * chunk
        var hi = lo + chunk
        if hi > n:
            hi = n
        var s: Float64 = 0.0
        var i = lo
        while i < hi:
            s += xp[i]
            i += 1
        pp[w] = s
    parallelize[one](workers, workers)
    var total: Float64 = 0.0
    for w in range(workers):
        total += partial[w]
    return total


def fixed_sum(x: List[Float64], workers: Int) -> Float64:
    var n = len(x)
    var xp = x.unsafe_ptr()
    var block = List[Float64]()
    for _ in range(N_BLOCKS):
        block.append(0.0)
    var bp = block.unsafe_ptr()
    var size = (n + N_BLOCKS - 1) // N_BLOCKS
    @parameter
    def one(b: Int):
        var lo = b * size
        var hi = lo + size
        if hi > n:
            hi = n
        var s: Float64 = 0.0
        var c: Float64 = 0.0
        var i = lo
        while i < hi:
            var y = xp[i] - c
            var t = s + y
            c = (t - s) - y
            s = t
            i += 1
        bp[b] = s
    parallelize[one](N_BLOCKS, workers)
    # fixed pairwise tree over the block sums (N_BLOCKS is a power of two)
    var m = N_BLOCKS
    while m > 1:
        var half = m // 2
        for k in range(half):
            block[k] = block[2 * k] + block[2 * k + 1]
        m = half
    return block[0]


def main():
    var n = 10_000_000
    var x = List[Float64]()
    var state: UInt64 = 2026
    for _ in range(n):
        state = state * 6364136223846793005 + 1442695040888963407
        var u = Float64(state >> 11) * (1.0 / 9007199254740992.0)
        state = state * 6364136223846793005 + 1442695040888963407
        var e = Int((state >> 33) % 13)
        var mag: Float64 = 1.0
        for _ in range(e):
            mag *= 10.0
        x.append((u - 0.5) * mag * 1.0e-6)
    var xr = List[Float64]()
    for i in range(n):
        xr.append(x[n - 1 - i])
    var f1 = fixed_sum(x, 1)
    var fr = fixed_sum(xr, 1)
    var g1 = naive_sum(x, 1)
    var gr = naive_sum(xr, 1)
    print("KEY fixed", f1, "reversed_input", fr, "same", f1 == fr)
    print("KEY naive", g1, "reversed_input", gr, "same", g1 == gr)
    for w in [1, 16]:
        var bf: Float64 = 1.0e30
        var bg: Float64 = 1.0e30
        for _ in range(7):
            var t0 = perf_counter_ns()
            var f = fixed_sum(x, w)
            var t1 = perf_counter_ns()
            var g = naive_sum(x, w)
            var t2 = perf_counter_ns()
            var df = Float64(t1 - t0) / 1.0e6
            var dg = Float64(t2 - t1) / 1.0e6
            if df < bf:
                bf = df
            if dg < bg:
                bg = dg
            if f != f1:
                print("MISMATCH", f, g)
        print("KEY time_ms workers", w, "fixed", bf, "naive", bg)
